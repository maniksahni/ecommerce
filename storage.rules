rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (request.auth.token.get('admin', false) == true || request.auth.token.get('email', '') in ['maniksahni@gmail.com', 'admin@shivaragroup.com', 'imperialshivam@gmail.com']);
    }
    match /products/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
  }
}
