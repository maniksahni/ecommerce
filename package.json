{
  "name": "shivara-luxe",
  "version": "1.2.0",
  "description": "A premium ecommerce storefront for Shivara.luxe statement jewellery.",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "audit:catalog": "node scripts/catalog-audit.js",
    "audit:routes": "node scripts/storefront-route-audit.js",
    "test": "npm run audit:catalog && npm run test:admin && npm run test:security",
    "test:security": "node scripts/test-production-security.js",
    "test:smoke": "node scripts/smoke-test.js",
    "test:experience": "node scripts/experience-test.js",
    "test:storefront": "node scripts/storefront-consistency-test.js",
    "test:production": "node scripts/production-test.js",
    "test:backend-crud": "node scripts/test-backend-crud.js",
    "test:oms": "node scripts/test-oms-flow.js",
    "test:architecture": "npm run test:realtime",
    "test:cart-matrix": "node scripts/test-cart-drawer-matrix.js",
    "build": "node scripts/netlify-build.js",
    "build:netlify": "node scripts/netlify-build.js",
    "deploy:firebase": "npm run build && npx --yes firebase-tools deploy --only hosting,firestore:rules",
    "test:netlify": "npm run build:netlify && node scripts/netlify-build-test.js",
    "test:admin": "node --test --test-reporter=dot scripts/admin-tests/*.test.js",
    "test:admin:live": "node scripts/admin-tests/live-browser.js",
    "test:realtime": "node scripts/test-realtime-commerce.cjs",
    "test:mobile": "node scripts/test-mobile-layout.cjs"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.61.1"
  },
  "engines": {
    "node": ">=20"
  }
}
