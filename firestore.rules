rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for admin authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Products: Public read for storefront; Authenticated admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Orders:
    // - Public customer can get a single order by direct ID (for order tracking)
    // - Public customer can create an order with valid schema and initial Pending/Confirmed status
    // - Only authenticated admins can list orders, change statuses, or delete orders
    match /orders/{orderId} {
      allow get: if true;
      allow list: if isAuthenticated();
      allow create: if request.resource.data.keys().hasAll(['id', 'items', 'total', 'customer', 'status', 'createdAt'])
                    && request.resource.data.status in ['Pending', 'pending', 'Confirmed', 'confirmed']
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0;
      allow update, delete: if isAuthenticated();
    }

    // Customers CRM: Strictly admin-only for customer privacy
    match /customers/{customerId} {
      allow read, write: if isAuthenticated();
    }

    // Coupons: Public read for storefront checkout validation; Admin-only write
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Admin Settings: Public read for storefront configuration; Admin-only write
    match /admin_settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Banners: Public read for promotional banners; Admin-only write
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Inventory: Public read; Admin-only write
    match /inventory/{itemId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Default deny for any other collections unless authenticated
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
