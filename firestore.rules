rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Strict Admin Authorization: Custom admin claim or explicitly approved admin email allowlist
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email in ['maniksahni@gmail.com', 'admin@shivaragroup.com', 'imperialshivam@gmail.com']
      );
    }

    // Products: Public read for storefront; Admin-only write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories: Public read for storefront; Admin-only write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders:
    // - Public customer can get a single order by direct ID
    // - Only authenticated admins can list orders, change statuses, or delete orders
    // - Customers can create validated COD Pending orders; admins have full access
    match /orders/{orderId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.paymentMethod == "COD" &&
        request.resource.data.status == "Pending"
      );
      allow update, delete: if isAdmin();
    }

    // Customers CRM: Strictly admin-only for customer privacy
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // Order Tracking Projection (Public lookup with masked PII)
    match /order_tracking/{orderId} {
      allow get: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Coupons: Public read for storefront; Admin-only write
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin Settings: Public read for storefront; Admin-only write
    match /admin_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banners: Public read for promotional banners; Admin-only write
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Inventory: Public read for storefront live stock availability; Admin-only write
    // Note: Public unauthenticated mutations (including stock decrements and isSoldOut changes) are strictly FORBIDDEN.
    match /inventory/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny for any other collections unless authenticated admin
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
